{
	"name": "@himynameisdave/oxlint-config",
	"version": "1.0.0",
	"description": "An opinionated oxlint config, by and for himynameisdave.",
	"keywords": [
		"config",
		"himynameisdave",
		"lint",
		"linter",
		"oxc",
		"oxlint",
		"oxlint-config"
	],
	"homepage": "https://github.com/himynameisdave/oxlint-config",
	"bugs": {
		"url": "https://github.com/himynameisdave/oxlint-config/issues"
	},
	"license": "MIT",
	"author": "Dave Lunny <d@velunny.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/himynameisdave/oxlint-config.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./base": {
			"types": "./dist/base.d.ts",
			"default": "./dist/base.js"
		},
		"./svelte": {
			"types": "./dist/svelte.d.ts",
			"default": "./dist/svelte.js"
		},
		"./type-aware": {
			"types": "./dist/type-aware.d.ts",
			"default": "./dist/type-aware.js"
		},
		"./vitest": {
			"types": "./dist/vitest.d.ts",
			"default": "./dist/vitest.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"lint": "tsc && oxlint -c oxlint.config.ts --deny-warnings",
		"check-coverage": "tsc && bun scripts/check-coverage.ts",
		"test:consumer": "tsc && bun scripts/consumer-smoke.ts",
		"prepublishOnly": "npm run build",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"test": "bun run lint && bun run format:check && bun run check-coverage && bun run test:consumer",
		"release": "np"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"np": "^12.0.0",
		"oxfmt": "0.61.0",
		"oxlint": "1.76.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.0"
	},
	"peerDependencies": {
		"oxlint": ">=1.76.0 <2",
		"oxlint-tsgolint": ">=7.0.2001"
	},
	"peerDependenciesMeta": {
		"oxlint-tsgolint": {
			"optional": true
		}
	},
	"packageManager": "bun@1.3.13"
}
